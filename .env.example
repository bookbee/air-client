# air-client — copy to `.env` (git-ignored) to preset the console.
#
# `make env` does the copy for you. Every value here is only a starting point:
# the sidebar can override each one at runtime, which is the whole point of a
# hand-testing console.
#
# The console runs on your machine and connects out to whichever AIR deployment
# you are testing. Declare each of those as a *target* below and switch between
# them from the sidebar — the console then labels every screen and every Send
# button with the target it is about to hit.

# ── Which target is selected at start-up ──────────────────────────────────────
# Must name one of the targets below. `local` always exists. An unknown name
# falls back to `local` rather than connecting somewhere unintended.

AIR_CLIENT__TARGET=local

# ── local ─────────────────────────────────────────────────────────────────────
# Pre-wired to the AIR port map (air-infra/README.md): 8081 air-platform,
# 8082 air-classifier. Every value below is already the built-in default, so
# this block only needs editing if your local ports differ.

AIR_CLIENT__TARGETS__LOCAL__LABEL=Local — services on this machine
AIR_CLIENT__TARGETS__LOCAL__CLASSIFIER_BASE_URL=http://127.0.0.1:8082
# air-classifier's own .env.example ships this development key, valid only
# against that repo's development hash salt. It is a default rather than an
# auth bypass on purpose: a local run then exercises the same authenticated
# path as QA, so key handling bugs surface here and not there.
AIR_CLIENT__TARGETS__LOCAL__CLASSIFIER_API_KEY=airc_local_dev_key
AIR_CLIENT__TARGETS__LOCAL__PLATFORM_BASE_URL=http://127.0.0.1:8081
AIR_CLIENT__TARGETS__LOCAL__PLATFORM_API_KEY=

# ── Remote targets ────────────────────────────────────────────────────────────
# Uncomment and fill in for each deployment you test against. The name between
# TARGETS__ and the field is yours to choose; it appears in the sidebar and in
# the target bar at the top of every screen. Anything not on this machine is
# flagged REMOTE in amber throughout the UI.
#
# Keys here are real credentials in an untracked file. Do not commit `.env`.

#AIR_CLIENT__TARGETS__DEV__LABEL=Dev (shared)
#AIR_CLIENT__TARGETS__DEV__CLASSIFIER_BASE_URL=https://classifier.dev.example.internal
#AIR_CLIENT__TARGETS__DEV__CLASSIFIER_API_KEY=
#AIR_CLIENT__TARGETS__DEV__PLATFORM_BASE_URL=https://platform.dev.example.internal
#AIR_CLIENT__TARGETS__DEV__PLATFORM_API_KEY=

#AIR_CLIENT__TARGETS__QA__LABEL=QA
#AIR_CLIENT__TARGETS__QA__CLASSIFIER_BASE_URL=https://classifier.qa.example.internal
#AIR_CLIENT__TARGETS__QA__CLASSIFIER_API_KEY=
#AIR_CLIENT__TARGETS__QA__PLATFORM_BASE_URL=https://platform.qa.example.internal
#AIR_CLIENT__TARGETS__QA__PLATFORM_API_KEY=

# ── Client behaviour ──────────────────────────────────────────────────────────

# Seconds before the console gives up on a request. Generous by default: the
# t3 cloud rung, a cold local model, or a remote environment scaled to zero can
# all take a while.
AIR_CLIENT__TIMEOUT_SECONDS=60
# Verify TLS certificates. Turn off only for self-signed staging endpoints.
AIR_CLIENT__VERIFY_TLS=true

# Appearance at start-up: auto | light | dark. `auto` follows the operating
# system, Streamlit's own widget chrome included. The sidebar can override it
# per session; `make run THEME=dark` forces it from launch.
AIR_CLIENT__THEME=auto

# ── Flat form (still supported) ───────────────────────────────────────────────
# These predate named targets and are read as edits to `local`. Prefer a target
# block above; a `.env` that uses these keeps working unchanged.
#AIR_CLIENT__CLASSIFIER_BASE_URL=http://127.0.0.1:8082
#AIR_CLIENT__CLASSIFIER_API_KEY=airc_local_dev_key
#AIR_CLIENT__PLATFORM_BASE_URL=http://127.0.0.1:8081
#AIR_CLIENT__PLATFORM_API_KEY=
