# air-client — copy to `.env` (git-ignored) to preset the sidebar.
#
# Every value here is only a starting point: the sidebar can override each one
# at runtime, which is the whole point of a hand-testing console.

# ── air-classifier ────────────────────────────────────────────────────────────
# Formerly air-sentiment. The repo was renamed; the service internals were not,
# so its own settings prefix is still AIR_SENTIMENT__ and its routes are still
# /v1/sentiment, /v1/feedback and /v1/reviews.
#
# The two keys below are this console's, and they did follow the rename. The old
# AIR_CLIENT__SENTIMENT_* spellings still work, so an existing .env keeps going.

AIR_CLIENT__CLASSIFIER_BASE_URL=http://127.0.0.1:8080
# Sent as the `X-API-Key` header. Leave unset when the service runs with
# AIR_SENTIMENT__SECURITY__ALLOW_UNAUTHENTICATED=true, which is the local default.
#AIR_CLIENT__CLASSIFIER_API_KEY=

# ── air-platform (chat) ───────────────────────────────────────────────────────
# The chat API does not exist yet; these are placeholders for when it lands.

AIR_CLIENT__PLATFORM_BASE_URL=http://127.0.0.1:8081
#AIR_CLIENT__PLATFORM_API_KEY=

# ── Client behaviour ──────────────────────────────────────────────────────────

# Seconds before the console gives up on a request. Generous by default: the
# t3 cloud rung plus a cold local model can take a while.
AIR_CLIENT__TIMEOUT_SECONDS=60
# Verify TLS certificates. Turn off only for self-signed staging endpoints.
AIR_CLIENT__VERIFY_TLS=true
